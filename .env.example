# Optional Azure caption rewriting only. Supply real values in a local .env.
# Never commit credentials. Inference and reviewed caption maps need no API key.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT

# Optional HTTP/demo defaults.
URBAN_CHANGE_CHECKPOINT=artifacts/MCI_model_augmented.pth
URBAN_CHANGE_DEVICE=auto
